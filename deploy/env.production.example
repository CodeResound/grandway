# =============================================================================
# Grandway — production environment
#
# Install this file as /etc/grandway/grandway.env (root:grandway, mode 0640):
#
#     install -m 0640 -o root -g grandway deploy/env.production.example /etc/grandway/grandway.env
#
# It is loaded into the PROCESS environment by every systemd unit
# (EnvironmentFile=/etc/grandway/grandway.env) and by deploy/manage.sh
# (`set -a; . file; set +a`). That is the only supported way to configure the
# application on a host — see deploy.md §7 (Configuration contract).
#
# The code can also read a `<repo>/.env.production` file, but do NOT use that
# path: it delivers only the settings-module variables (blocks 1-10 below).
# SUPERADMIN_* (block 11) and GUNICORN_* (block 12) are read with os.environ
# directly and never see an env file. And because the OS environment is
# consulted first, a value set in the process environment always wins over the
# file anyway — one file, one loader, no precedence puzzles.
#
# Values must be shell-, systemd- and decouple-safe: KEY=value, one per line,
# quote any value containing spaces ("System Administrator"), no `export`,
# no `$` expansion, no inline comments after a value.
#
# MUST-REPLACE values are marked CHANGE-ME. Anything without a default listed
# here is mandatory: the process refuses to boot without it, by design.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment selection
#
# *** READ THIS ONE. It is the most common day-one deployment failure. ***
#
# ENVIRONMENT must be present in the PROCESS environment. It is read by
# core/settings/__init__.py BEFORE production settings open any env file. With
# the systemd EnvironmentFile= / manage.sh loader above, this line delivers it;
# with any other loader you must export it yourself:
#
#   systemd:  EnvironmentFile=/etc/grandway/grandway.env  (this file)
#   shell:    set -a; . /etc/grandway/grandway.env; set +a
#
# deploy.md §15 verifies the file with:  grep -q '^ENVIRONMENT=production$'
# -----------------------------------------------------------------------------
ENVIRONMENT=production

# -----------------------------------------------------------------------------
# 2. Secrets (mandatory)
#
# Generate a fresh key — never reuse the development one:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
#
# token_urlsafe is used deliberately instead of Django's get_random_secret_key:
# Django's alphabet includes # $ % ^ & * ( ), which break a file that is
# sourced by a shell (`#` starts a comment, `$` expands). token_urlsafe emits
# only A-Z a-z 0-9 - _ and is at least as strong.
#
# SECRET_KEY also signs JWTs. Rotating it invalidates every issued token and
# logs every user out; that is the intended behaviour after a compromise.
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGE-ME-generate-a-fresh-key-with-the-one-liner-above

# -----------------------------------------------------------------------------
# 3. Database (mandatory — PostgreSQL 16; SQLite cannot run this application)
# -----------------------------------------------------------------------------
DB_NAME=grandway
DB_USER=grandway
DB_PASSWORD=CHANGE-ME-strong-password
DB_HOST=localhost
DB_PORT=5432
# Seconds a connection is reused. 0 disables pooling. Raise only with a
# connection pooler in front; see deploy.md §4 (Runtime requirements).
DB_CONN_MAX_AGE=60

# -----------------------------------------------------------------------------
# 4. Hosts and browser origins (mandatory — no defaults in production)
#
# ALLOWED_HOSTS is the bare hostname(s), comma-separated, no scheme.
# The two origin lists are full origins WITH scheme.
#
# If the frontend is served from a DIFFERENT origin than the API, put the
# frontend's origin in CORS_ALLOWED_ORIGINS — it is the browser origin allowed
# to call this API and to send the refresh cookie.
# -----------------------------------------------------------------------------
ALLOWED_HOSTS=admin.grandwayeducation.com
CORS_ALLOWED_ORIGINS=https://admin.grandwayeducation.com
CSRF_TRUSTED_ORIGINS=https://admin.grandwayeducation.com

# -----------------------------------------------------------------------------
# 5. Reverse proxy
#
# NUM_PROXIES must equal the real number of proxies between the client and
# gunicorn (nginx alone = 1; nginx behind Cloudflare = 2). It decides which
# entry of X-Forwarded-For is treated as the client IP, and it drives BOTH DRF
# throttling and django-axes lockout. Too high and any client can spoof its way
# past both by sending its own X-Forwarded-For header; too low and every client
# looks like the proxy, so one user's failed logins lock out everybody.
# -----------------------------------------------------------------------------
NUM_PROXIES=1

# -----------------------------------------------------------------------------
# 6. Cache / throttle store (CACHE_BACKEND mandatory)
#
# DRF throttle counters live here. With the per-process LocMemCache, every rate
# limit is multiplied by the worker count and resets on restart — so production
# refuses to start on LocMemCache unless you explicitly acknowledge a
# single-worker deployment. Use a shared backend for any multi-worker deploy.
#
# Redis/Valkey is a derived, rebuildable store — losing it costs throttle
# counters and nothing else. The `redis` Python client the backend needs is in
# requirements/production.txt.
# -----------------------------------------------------------------------------
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://127.0.0.1:6379/1
# Set true ONLY if running exactly one gunicorn worker with LocMemCache.
# THROTTLE_SINGLE_WORKER=false

# -----------------------------------------------------------------------------
# 7. Filesystem paths
#
# *** The static/media split below is deliberate and load-bearing. ***
#
# STATIC_ROOT is public by design: nginx serves it at /static/.
# MEDIA_ROOT holds applicant passports, transcripts, and bank statements. It is
# NEVER web-served — the only path from disk to a client is the authenticated
# download endpoint. It is kept OUTSIDE /var/www entirely so that no `root`
# directive in any nginx config can ever expose it, however the proxy is later
# edited. Do not "tidy" it back under the web root.
#
# Both directories, and LOG_DIR, must be writable by the user the application
# runs as. MEDIA_ROOT is the primary backup target alongside the database.
# -----------------------------------------------------------------------------
STATIC_ROOT=/var/www/grandway/static
MEDIA_ROOT=/var/lib/grandway/media
LOG_DIR=/var/log/grandway

# -----------------------------------------------------------------------------
# 8. Session and device policy (all optional — defaults shown)
# -----------------------------------------------------------------------------
# AUTH_SESSION_IDLE_HOURS=12
# AUTH_SESSION_ABSOLUTE_DAYS=7
# AUTH_MAX_ACTIVE_DEVICES=3
# AUTH_SESSION_LAST_USED_MINUTES=5

# -----------------------------------------------------------------------------
# 9. Login lockout — django-axes (optional — defaults shown)
# Locks on the username+IP pair; see NUM_PROXIES above for why that is
# sensitive to proxy configuration.
# -----------------------------------------------------------------------------
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_MINUTES=15

# -----------------------------------------------------------------------------
# 10. JWT and TOTP labelling (optional — defaults shown)
# OTP_TOTP_ISSUER is the name shown in the operator's authenticator app.
# -----------------------------------------------------------------------------
# JWT_ISSUER=grandway
# JWT_AUDIENCE=grandway-api
# OTP_TOTP_ISSUER=Grandway

# -----------------------------------------------------------------------------
# 11. First-boot bootstrap only (process environment only) — do NOT leave set
#
# Read by `manage.py bootstrap_superadmin` and the two reset_superadmin_*
# commands straight from the process environment (os.environ) — NOT from a
# .env.production file. This file reaches them only because manage.sh / systemd
# load it into the process environment. Leave SUPERADMIN_PASSWORD UNSET: the
# command then generates a password, prints it once, and forces a change at
# first login. Remove this block after first boot.
# -----------------------------------------------------------------------------
# SUPERADMIN_USERNAME=admin
# SUPERADMIN_EMAIL=admin@grandwayeducation.com
# SUPERADMIN_DISPLAY_NAME="System Administrator"

# -----------------------------------------------------------------------------
# 12. Application server (process environment only)
#
# Read by deploy/gunicorn.conf.py from os.environ — never from an env file.
# Defaults shown. Keep GUNICORN_BIND on the loopback: nginx is the only thing
# that should reach it. GUNICORN_TIMEOUT is coupled to nginx's
# proxy_read_timeout (60s in deploy/nginx.sample.conf): keep the proxy value
# greater than or equal to this one, and raise them together.
# -----------------------------------------------------------------------------
# GUNICORN_BIND=127.0.0.1:8000
# GUNICORN_WORKERS=<cpu*2+1>
# GUNICORN_TIMEOUT=60
# GUNICORN_LOG_LEVEL=info
