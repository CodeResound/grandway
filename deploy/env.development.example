# =============================================================================
# Grandway — local development environment
#
# Copy to the repository root as `.env.development`:
#
#     cp deploy/env.development.example .env.development
#
# Also create a repo-root `.env` containing `ENVIRONMENT=development` so
# manage.py commands need not export it by hand:
#
#     echo "ENVIRONMENT=development" > .env
#
# Both are gitignored. This template lives under deploy/ (no leading dot in the
# filename) so that it IS tracked and reaches a fresh clone — the dotted
# .env.* files never do.
#
# Throwaway values only. Never put a real credential in this file.
# =============================================================================

ENVIRONMENT=development
SECRET_KEY=dev-secret-key-replace-before-staging
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.110.58:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.110.58:3000
DB_NAME=grandway
DB_USER=dev
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# How many reverse proxies sit in front of the app. 0 = none (X-Forwarded-For is
# ignored in favour of REMOTE_ADDR), which is right for local development. Set it
# to the real hop count in staging/production — one for a single nginx, two
# behind nginx + a load balancer. Both DRF's rate limiting and django-axes'
# lockout read this, so it must match the deployment or they will count
# different identities. Too low is safe; too high trusts a client-supplied header.
NUM_PROXIES=0

# Backend for the cache DRF's rate limiting keeps its counters in. LocMemCache is
# per-process: correct for a single-process deployment, but under gunicorn with N
# workers it multiplies every configured rate limit by N. A multi-worker
# deployment must point these at a shared backend or its rate limits are
# decorative.
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1
