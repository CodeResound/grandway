# Grandway nightly backup — timer.
#
# Fires grandway-backup.service nightly at 01:30 Nepal time (Asia/Kathmandu,
# UTC+05:45 — 19:45 UTC), i.e. 45 minutes BEFORE the 02:15 notification sweep,
# so the snapshot never overlaps the one scheduled writer. Persistent=true runs
# a missed backup as soon as the host is back up.
#
# The backup lands in /var/backups/grandway (root 0700) and is pruned after 14
# days by backup.sh. Copying it OFF the host is a deployer decision the script
# does not make — see deploy.md §17 (Backup and restore) and §22 (Gaps).

[Unit]
Description=Nightly Grandway backup at 01:30 Asia/Kathmandu

[Timer]
OnCalendar=*-*-* 01:30:00 Asia/Kathmandu
Persistent=true
Unit=grandway-backup.service

[Install]
WantedBy=timers.target
