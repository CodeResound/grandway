#!/usr/bin/env bash
# pre-push hook — CLAUDE.md §34 (the git cycle) and §41 (releases).
#
# What happens to a push, by the branch it targets on the remote:
#
#   main, dev            PR-only. BLOCKED unless ALLOW_DIRECT_PUSH=1 (human-only override
#                        for bootstrap and the main -> dev merge-back); deletion is always
#                        blocked. With the override, the CI gates below run first.
#   release/*, hotfix/*  Gated: scripts/ci.sh (lint, migrations, export, docs, test) plus
#                        the DB-backed policy stage when PostgreSQL is reachable. These
#                        branches PR into main, so they must be green before they leave
#                        the machine.
#   everything else      feature/*, fix/*, refactor/*, chore/* push freely — the PR into
#                        dev and its CI (.github/workflows/ci.yml) are their gate.
#
# Tracked in .githooks/ (not .git/hooks/, which is untracked and lost on clone).
# Enable once per clone:
#
#     git config core.hooksPath .githooks
#
# Advisory backstop only — a local hook is bypassable. GitHub branch protection
# (.github/branch-protection/*.json) and the workflows in .github/workflows/ are the
# authoritative enforcement.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

ZERO_SHA="0000000000000000000000000000000000000000"
ALLOW_DIRECT_PUSH="${ALLOW_DIRECT_PUSH:-0}"

# Git feeds us one line per pushed ref:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# A local_sha of all zeros means the push deletes the remote branch.
gated_branches=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [[ -z "${remote_ref:-}" ]] && continue
  branch="${remote_ref#refs/heads/}"
  case "$branch" in
    main|dev)
      if [[ "$local_sha" == "$ZERO_SHA" ]]; then
        echo "pre-push: BLOCKED — refusing to delete '${branch}' (CLAUDE.md §34)." >&2
        exit 1
      fi
      if [[ "$ALLOW_DIRECT_PUSH" != "1" ]]; then
        echo "pre-push: BLOCKED — '${branch}' is PR-only (CLAUDE.md §34)." >&2
        echo "  Open a PR:  gh pr create --base ${branch}" >&2
        echo "  Human-only override (bootstrap / merge-back):  ALLOW_DIRECT_PUSH=1 git push ..." >&2
        exit 1
      fi
      echo "pre-push: ALLOW_DIRECT_PUSH=1 — direct push to '${branch}' permitted; running the CI gates first." >&2
      gated_branches="${gated_branches} ${branch}"
      ;;
    release/*|hotfix/*)
      [[ "$local_sha" == "$ZERO_SHA" ]] && continue
      gated_branches="${gated_branches} ${branch}"
      ;;
    *)
      # Task branches are gated by their PR's CI, not here.
      ;;
  esac
done

if [[ -z "$gated_branches" ]]; then
  exit 0
fi

gated_branches="${gated_branches# }"
echo "pre-push: push targets gated branch(es): ${gated_branches} — running the CI gates (CLAUDE.md §34)." >&2

# Work whether or not the developer activated the venv in this shell.
if [[ -d "$REPO_ROOT/.venv/bin" ]]; then
  PATH="$REPO_ROOT/.venv/bin:$PATH"
  export PATH
fi

if ! command -v python >/dev/null 2>&1; then
  echo "pre-push: BLOCKED — no \`python\` on PATH and no .venv/ in the repo." >&2
  echo "  Create it:  python3.12 -m venv .venv && .venv/bin/pip install -r requirements/development.txt" >&2
  exit 1
fi

fail() {
  echo "" >&2
  echo "pre-push: BLOCKED — the '$1' stage failed. Push to ${gated_branches} aborted." >&2
  echo "  Fix the failure and push again. Do NOT use --no-verify (CLAUDE.md §34)." >&2
  exit 1
}

# Database-less stages: ruff, migration drift, policy-artifact drift, consumer
# contracts, pytest. This list is hardcoded rather than using ci.sh's default-all
# path, so a newly added DB-less stage must be added here too.
bash scripts/ci.sh lint migrations export docs test || fail "lint/migrations/export/docs/test"

# The `policy` stage (migrate -> sync -> validate) needs a reachable PostgreSQL.
# Read the connection target from .env.development so this follows the real config.
db_host="localhost"
db_port="5432"
if [[ -f "$REPO_ROOT/.env.development" ]]; then
  db_host="$(sed -n 's/^DB_HOST=//p' "$REPO_ROOT/.env.development" | tail -1)"
  db_port="$(sed -n 's/^DB_PORT=//p' "$REPO_ROOT/.env.development" | tail -1)"
  db_host="${db_host:-localhost}"
  db_port="${db_port:-5432}"
fi

# Probe with bash's built-in /dev/tcp — no `nc` dependency.
if (exec 3<>"/dev/tcp/${db_host}/${db_port}") 2>/dev/null; then
  exec 3>&- 2>/dev/null || true
  bash scripts/ci.sh policy || fail "policy"
else
  echo "" >&2
  echo "pre-push: WARNING — PostgreSQL unreachable at ${db_host}:${db_port}; skipping the 'policy' stage." >&2
  echo "  Start it and retry to run the policy stage locally." >&2
  echo "  Policy-engine drift is still enforced by GitHub Actions after this push lands." >&2
fi

echo "" >&2
echo "pre-push: all gates passed — allowing the push to ${gated_branches}." >&2
exit 0
